# Copy to deploy/.env on the server (never commit it). Generate secrets with:
#   openssl rand -hex 32        (POSTGRES_PASSWORD)
#   openssl rand -base64 48     (DJANGO_SECRET_KEY)
#   cat /proc/sys/kernel/random/uuid   (KDPS_DEPLOYMENT_KEY, fresh install only)

# The API's public hostname, pointing at this server. No domain yet? Use
# <ip-with-dashes>.sslip.io, e.g. 187-126-127-252.sslip.io
DOMAIN=

# The Vercel origin that proxies /api here (no trailing slash).
FRONTEND_ORIGIN=https://kdps-pos.vercel.app

POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Binds this deployment to its one tenant. A fresh install gets a new UUID.
# Moving the existing Railway data here? Use Railway's KDPS_DEPLOYMENT_KEY
# instead, or the restored tenant will not match.
KDPS_DEPLOYMENT_KEY=

# API worker processes (backend/start.sh). One CPU-heavy read in a single
# worker holds up every other request; raise this with the server's cores.
WEB_CONCURRENCY=2

# Synthetic (test) deployments only: one-tap sign-in chips on the login page,
# as one line of JSON. Anyone who opens the site can use them, so put only test
# passwords here; the API ignores it unless the tenant is synthetic.
# KDPS_DEMO_LOGINS=[{"label":"Owner","email":"syn.owner@synthetic.demo","password":"..."}]
