# Local rehearsal settings (deploy/compose.rehearsal.yaml). Placeholders only.
# scripts/rehearse_store_opening.sh writes deploy/.env.rehearsal (git-ignored)
# from this file with fresh random secrets the first time it runs. Never copy
# the server's deploy/.env here.

DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:5173

POSTGRES_PASSWORD=change-me-rehearsal-only
DJANGO_SECRET_KEY=change-me-rehearsal-only
KDPS_DEPLOYMENT_KEY=00000000-0000-0000-0000-000000000000
# The synthetic owner's password for bootstrap_deployment (never printed).
KDPS_BOOTSTRAP_ADMIN_PASSWORD=change-me-rehearsal-only

WEB_CONCURRENCY=2

# The API's loopback port; pick a free one.
REHEARSAL_API_PORT=58080
